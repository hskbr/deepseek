# ROTEIA_API_KEY: Required for DeepSeek API calls via Roteia (https://api.roteia.ai/v1/chat/completions)
# Set your API Key in your environment secrets or .env file
ROTEIA_API_KEY="sk_roteia_your_key_here"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
